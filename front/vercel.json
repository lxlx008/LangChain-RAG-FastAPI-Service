{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "env": {
    "BACKEND_URL": "@BACKEND_URL"
  },
  "rewrites": [
    {
      "source": "/chat/:path*",
      "destination": "https://rag-backend-xxxx.onrender.com/chat/:path*"
    },
    {
      "source": "/knowledge/:path*",
      "destination": "https://rag-backend-xxxx.onrender.com/knowledge/:path*"
    },
    {
      "source": "/health/:path*",
      "destination": "https://rag-backend-xxxx.onrender.com/health/:path*"
    },
    {
      "source": "/api/:path*",
      "destination": "https://rag-backend-xxxx.onrender.com/api/:path*"
    },
    {
      "source": "/user/:path*",
      "destination": "https://rag-backend-xxxx.onrender.com/user/:path*"
    },
    {
      "source": "/file/:path*",
      "destination": "https://rag-backend-xxxx.onrender.com/file/:path*"
    }
  ]
}