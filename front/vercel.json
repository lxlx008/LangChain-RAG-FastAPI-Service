{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "env": {
    "BACKEND_URL": "@BACKEND_URL"
  },
  "rewrites": [
    {
      "source": "/chat/:path*",
      "destination": "/chat/:path*"
    },
    {
      "source": "/knowledge/:path*",
      "destination": "/knowledge/:path*"
    },
    {
      "source": "/health/:path*",
      "destination": "/health/:path*"
    },
    {
      "source": "/api/:path*",
      "destination": "/api/:path*"
    }
  ]
}